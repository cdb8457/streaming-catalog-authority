# Projection Phase 6 — THE ALPHA ENVIRONMENT CONTRACT, in full.
#
# Copy this, fill in absolute paths that exist on YOUR host, and source it before running
# `deploy/projection-alpha.sh`. Every variable below is REQUIRED and none has a default: a default here would
# be an appliance that silently mounts over whatever it found.
#
# THERE IS NO VARIABLE IN THIS FILE THAT HOLDS A CREDENTIAL, AND THERE NEVER WILL BE. A token is a FILE, and
# what this contract carries is the DIRECTORY those files live in. An environment that leaked could not leak a
# credential, which is the same rule the daemon's configuration has had since Phase 1.
#
# EVERY PATH MUST BE ABSOLUTE AND UNAMBIGUOUS. `preflight` refuses a relative path rather than resolving one,
# because resolving one means resolving it against whatever directory the operator happened to be in.

# The image. NO FLOATING TAGS. A digest is what makes two runs of this appliance provably runs of the same
# thing; `preflight` refuses `:latest` outright and warns on any other bare tag.
#   e.g. projectiond@sha256:73996926dafa3078609b2ab9534032ff7032b30322fa9bcbac31643efdf82786
export PROJECTIOND_ALPHA_IMAGE=

# Where the control plane publishes pointer.json and the artifact. The daemon mounts this READ-ONLY: it
# consumes generations and never publishes one.
#   e.g. /mnt/user/appdata/projection-alpha/manifest
export PROJECTIOND_ALPHA_MANIFEST_DIR=

# The local media root the manifest's `local` sources are relative to. Mounted READ-ONLY.
#
# THIS APPLIANCE NEVER CREATES THIS DIRECTORY. It is your existing library, and a script that could create it
# is a script that could create it in the wrong place and then fill it.
#   e.g. /mnt/user/media
export PROJECTIOND_ALPHA_MEDIA_ROOT=

# A DURABLE directory. Two things live here and the second is why it matters more than it used to: the
# scan-window cache, which is what makes a re-scan free, AND THE RECOVERY LEDGER, which is what makes the
# recovery budget a bound. A tmpfs here would be a budget every restart refunds, which is not a budget.
#   e.g. /mnt/user/appdata/projection-alpha/cache
export PROJECTIOND_ALPHA_CACHE_DIR=

# The host directory the namespace appears at, and which your media servers read.
#
# YOUR MEDIA SERVER MUST BIND THIS BEFORE THE APPLIANCE FIRST MOUNTS THERE. §11 of the Phase 0 product
# contract, and `preflight` refuses to proceed without it: a bind taken while the path is a plain directory
# follows every later mount at that path, and a bind taken afterwards is stranded by the first recovery.
#   e.g. /mnt/user/appdata/projection-alpha/mnt
export PROJECTIOND_ALPHA_MOUNT=

# The daemon configuration file. `deploy/projectiond-operator-config.example.json` is the shape.
#   e.g. /mnt/user/appdata/projection-alpha/config.json
export PROJECTIOND_ALPHA_CONFIG=

# The directory holding provider token FILES, mounted read-only at /run/secrets. The configuration names a
# path under here; no value passes through this file, the command line, or the compose profile.
#   e.g. /mnt/user/appdata/projection-alpha/secrets
export PROJECTIOND_ALPHA_SECRETS_DIR=
